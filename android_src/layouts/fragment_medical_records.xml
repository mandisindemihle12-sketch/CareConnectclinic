<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/slate_50"
    android:padding="16dp">

    <!-- Header & Break Glass Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Electronic Health Records (EHR)"
                android:textSize="18sp"
                android:textColor="@color/slate_900"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIPAA § 164.312 Access Controlled"
                android:textSize="11sp"
                android:textColor="@color/slate_500" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_trigger_break_glass"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/rose_50"
            android:text="🚨 Break-Glass"
            android:textColor="@color/rose_600"
            android:textSize="11sp"
            android:textAllCaps="false"
            app:strokeColor="@color/rose_600"
            app:strokeWidth="1dp"
            app:cornerRadius="6dp" />
    </LinearLayout>

    <!-- Search Input -->
    <EditText
        android:id="@+id/et_search_records"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input"
        android:hint="Search diagnoses, provider, or notes..."
        android:paddingHorizontal="14dp"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_medical_records"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
