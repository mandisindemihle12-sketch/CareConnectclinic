<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/slate_200"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_patient_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Maya Lin"
                android:textSize="15sp"
                android:textColor="@color/slate_900"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_patient_mrn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MRN-882194"
                android:textSize="12sp"
                android:textColor="@color/slate_500" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_status_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_amber"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="WAITING"
                android:textSize="11sp"
                android:textColor="@color/amber_600"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_assigned_doc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Dr. Elena Vance"
                android:textSize="12sp"
                android:textColor="@color/slate_600" />

            <TextView
                android:id="@+id/tv_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Exam Room 3B"
                android:textSize="12sp"
                android:textColor="@color/teal_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_vitals_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Vitals: BP 118/76 | HR 72 | SpO2 99%"
            android:textSize="11sp"
            android:textColor="@color/slate_500" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
