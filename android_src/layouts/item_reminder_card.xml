<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/teal_primary"
    app:strokeWidth="1.5dp"
    app:cardBackgroundColor="@color/teal_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Upcoming Appointment Reminder"
                android:textSize="13sp"
                android:textColor="@color/teal_dark"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_teal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="In 18 hours"
                android:textSize="11sp"
                android:textColor="@color/teal_dark"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_reminder_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Visit with Dr. Elena Vance, MD"
            android:textSize="16sp"
            android:textColor="@color/slate_900"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_reminder_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tomorrow at 09:30 AM (In-Person Clinic Visit)"
            android:textSize="13sp"
            android:textColor="@color/slate_700" />

        <TextView
            android:id="@+id/tv_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="• Fasting required for 8 hours prior\n• Bring photo ID &amp; insurance card"
            android:textSize="12sp"
            android:textColor="@color/slate_600" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_attendance"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="@color/teal_primary"
                android:text="Confirm Attendance"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="8dp" />

            <TextView
                android:id="@+id/tv_confirmed_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="✓ Confirmed"
                android:textSize="13sp"
                android:textColor="@color/emerald_600"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
